generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  ONLINE_ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  TOP_CHOICE
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  SYSTEM_DESIGN
  BEHAVIORAL
  HR
  FINAL_ROUND
  TAKE_HOME
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ReminderType {
  APPLICATION_DEADLINE
  INTERVIEW_PREP
  FOLLOW_UP
  GENERAL
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  avatarUrl    String?
  targetRole   String?        @default("Software Development Engineer")
  bio          String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  applications Application[]
  interviews   Interview[]
  reminders    Reminder[]
  activityLogs ActivityLog[]

  @@map("users")
}

model Application {
  id                  String            @id @default(uuid())
  userId              String
  companyName         String
  jobTitle            String
  jobDescription      String?           @db.Text
  companyWebsite      String?
  jobPostingUrl       String?
  applicationDate     DateTime?
  applicationDeadline DateTime?
  location            String?           @default("Not Specified")
  workMode            WorkMode          @default(REMOTE)
  employmentType      String?           @default("Full-time Internship")
  salaryOrStipend     String?
  status              ApplicationStatus @default(APPLIED)
  priority            Priority          @default(MEDIUM)
  recruiterName       String?
  recruiterEmail      String?
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews   Interview[]
  reminders    Reminder[]
  activityLogs ActivityLog[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, companyName])
  @@index([userId, applicationDeadline])
  @@index([userId, createdAt])
  @@map("applications")
}

model Interview {
  id               String          @id @default(uuid())
  userId           String
  applicationId    String
  interviewDate    DateTime
  interviewType    InterviewType   @default(TECHNICAL)
  interviewRound   String          @default("Round 1")
  meetingLink      String?
  location         String?
  preparationNotes String?         @db.Text
  feedback         String?         @db.Text
  status           InterviewStatus @default(SCHEDULED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([userId, interviewDate])
  @@index([userId, status])
  @@map("interviews")
}

model Reminder {
  id            String       @id @default(uuid())
  userId        String
  applicationId String?
  title         String
  description   String?      @db.Text
  remindAt      DateTime
  isCompleted   Boolean      @default(false)
  type          ReminderType @default(GENERAL)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, remindAt])
  @@index([userId, isCompleted])
  @@map("reminders")
}

model ActivityLog {
  id            String   @id @default(uuid())
  userId        String
  applicationId String?
  actionType    String
  description   String   @db.Text
  metadata      Json?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([userId, createdAt])
  @@map("activity_logs")
}
